/* 27. RSA encryption of each alphabetic character separately */

#include <stdio.h>

long long power_mod(long long a, long long e, long long n)
{
    long long r = 1;
    while (e) {
        if (e & 1) r = (r * a) % n;
        a = (a * a) % n;
        e >>= 1;
    }
    return r;
}

int main()
{
    long long n, e, c[26];
    int i;

    printf("Enter n and e: ");
    scanf("%lld %lld", &n, &e);

    /* Build a codebook for A-Z */
    for (i = 0; i < 26; i++)
        c[i] = power_mod(i, e, n);

    printf("\nCodebook:\n");
    for (i = 0; i < 26; i++)
        printf("%c -> %lld\n", 'A' + i, c[i]);

    printf("\nAttack: compare each ciphertext with the codebook.\n");
    printf("Only 26 possible plaintext values exist.\n");
    printf("Therefore, the scheme is NOT secure.\n");

    return 0;
}
