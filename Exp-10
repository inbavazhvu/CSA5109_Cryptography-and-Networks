#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M', 'F', 'H', 'I', 'K'},
    {'U', 'N', 'O', 'P', 'Q'},
    {'Z', 'V', 'W', 'X', 'Y'},
    {'E', 'L', 'A', 'R', 'G'},
    {'D', 'S', 'T', 'B', 'C'}
};

/* Find the row and column of a character */
void findPosition(char ch, int *row, int *col)
{
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
        {
            if (matrix[i][j] == ch)
            {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Encrypt a pair of characters */
void encryptPair(char a, char b)
{
    int r1, c1, r2, c2;

    findPosition(a, &r1, &c1);
    findPosition(b, &r2, &c2);

    /* Same row */
    if (r1 == r2)
    {
        printf("%c%c",
               matrix[r1][(c1 + 1) % 5],
               matrix[r2][(c2 + 1) % 5]);
    }

    /* Same column */
    else if (c1 == c2)
    {
        printf("%c%c",
               matrix[(r1 + 1) % 5][c1],
               matrix[(r2 + 1) % 5][c2]);
    }

    /* Rectangle rule */
    else
    {
        printf("%c%c",
               matrix[r1][c2],
               matrix[r2][c1]);
    }
}

int main()
{
    char message[] =
        "MUST SEE YOU OVER CADOGAN WEST COMING AT ONCE";

    char text[200];
    int i, j = 0;

    /* Remove spaces and convert to uppercase */
    for (i = 0; message[i] != '\0'; i++)
    {
        if (isalpha(message[i]))
        {
            text[j++] = toupper(message[i]);
        }
    }

    text[j] = '\0';

    printf("Plaintext : %s\n", text);

    printf("Ciphertext: ");

    /* Encrypt two letters at a time */
    for (i = 0; i < j; i += 2)
    {
        if (i + 1 < j)
        {
            encryptPair(text[i], text[i + 1]);
        }
        else
        {
            /* Add X if one letter remains */
            encryptPair(text[i], 'X');
        }
    }

    printf("\n");

    return 0;
}
