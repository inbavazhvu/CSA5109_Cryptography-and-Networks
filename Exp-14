#include <stdio.h>
#include <string.h>

int main() {
    char p1[] = "SENDMOREMONEY";
    char p2[] = "CASHNOTNEEDED";
    int key[] = {9,0,1,7,23,15,21,14,11,11,2,8,9};
    int c[20], k2[20], i;

    /* Part (a): Encryption */
    printf("Ciphertext: ");
    for(i=0; i<13; i++) {
        c[i] = ((p1[i]-'A') + key[i]) % 26;
        printf("%c", c[i]+'A');
    }

    /* Part (b): Find key for CASHNOTNEEDED */
    printf("\nKey for part (b): ");
    for(i=0; i<13; i++) {
        k2[i] = (c[i] - (p2[i]-'A') + 26) % 26;
        printf("%d ", k2[i]);
    }

    return 0;
}
