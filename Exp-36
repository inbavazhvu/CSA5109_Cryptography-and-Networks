

#include <stdio.h>

int gcd(int a, int b)
{
    while (b) {
        int t = a % b;
        a = b;
        b = t;
    }
    return a;
}

int main()
{
    char p[100], c[100], d[100];
    int a, b, inv = -1, i;

    printf("Enter plaintext: ");
    scanf("%s", p);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    if (gcd(a, 26) != 1) {
        printf("Invalid a: encryption is not one-to-one.\n");
        return 0;
    }

    for (i = 0; i < 26; i++)
        if ((a * i) % 26 == 1)
            inv = i;

    for (i = 0; p[i]; i++)
        c[i] = ((a * (p[i]-'A') + b) % 26) + 'A';
    c[i] = '\0';

    for (i = 0; c[i]; i++)
        d[i] = (inv * ((c[i]-'A') - b + 26)) % 26 + 'A';
    d[i] = '\0';

    printf("Ciphertext: %s\n", c);
    printf("Decrypted : %s\n", d);

    return 0;
}
