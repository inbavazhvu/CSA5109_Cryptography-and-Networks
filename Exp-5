def affine_cipher(text, a, b):
    result = ""

    for ch in text.upper():
        if ch.isalpha():
            p = ord(ch) - ord('A')
            c = (a * p + b) % 26
            result += chr(c + ord('A'))
        else:
            result += ch

    return result


text = input("Enter plaintext: ")
a = int(input("Enter a: "))
b = int(input("Enter b: "))

print("Ciphertext:", affine_cipher(text, a, b))
