#include <stdio.h>

int gcd(int a, int b)
{
    while (b) {
        int t = a % b;
        a = b;
        b = t;
    }
    return a;
}

int main()
{
    int n, e, m, p, q, phi, d;

    printf("Enter n: ");
    scanf("%d", &n);

    printf("Enter e: ");
    scanf("%d", &e);

    printf("Enter plaintext block: ");
    scanf("%d", &m);

    p = gcd(m, n);

    if (p == 1) {
        printf("No common factor found\n");
        return 0;
    }

    q = n / p;
    phi = (p - 1) * (q - 1);

    for (d = 1; d < phi; d++)
        if ((e * d) % phi == 1)
            break;

    printf("p = %d\n", p);
    printf("q = %d\n", q);
    printf("phi(n) = %d\n", phi);
    printf("Private key = (%d, %d)\n", d, n);

    return 0;
}
