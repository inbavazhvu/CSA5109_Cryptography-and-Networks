uint64_t permute(uint64_t in, int *table) {
    uint64_t out = 0;
    int i;
    for(i=0;i<64;i++)
        out |= ((in >> (64-table[i])) & 1ULL) << (63-i);
    return out;
}

/* Simple demonstration of DES decryption */
uint64_t DES_decrypt(uint64_t block, uint64_t key[16]) {
    uint64_t data = permute(block, IP);

    /* DES rounds use K16 ... K1 */
    for(int i=15; i>=0; i--) {
        printf("Round %2d : Using K%d\n", 16-i, i+1);

        /* DES Feistel operation is performed here.
           F(R, K[i]) is omitted in this short version. */
    }

    data = permute(data, FP);
    return data;
}

