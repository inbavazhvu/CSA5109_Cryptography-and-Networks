

#include <stdio.h>

int main()
{
    int P[2][2] = {{0,1},{2,3}};
    int C[2][2] = {{19,7},{22,15}};
    int PI[2][2] = {{23,15},{15,23}};
    int K[2][2] = {0};
    int i, j, k;

    /* K = C * P^-1 mod 26 */
    for (i = 0; i < 2; i++)
        for (j = 0; j < 2; j++)
            for (k = 0; k < 2; k++)
                K[i][j] =
                    (K[i][j] + C[i][k] * PI[k][j]) % 26;

    printf("Recovered Hill Key:\n");

    for (i = 0; i < 2; i++)
        printf("%d %d\n", K[i][0], K[i][1]);

    return 0;
}
