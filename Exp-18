#include <stdio.h>
#include <stdint.h>

int PC1[56] = {
57,49,41,33,25,17,9,1,58,50,42,34,26,18,10,2,
59,51,43,35,27,19,11,3,60,52,44,36,63,55,47,39,
31,23,15,7,62,54,46,38,30,22,14,6,61,53,45,37,
29,21,13,5,28,20,12,4
};

int PC2[48] = {
14,17,11,24,1,5,3,28,15,6,21,10,23,19,12,4,
26,8,16,7,27,20,13,2,41,52,31,37,47,55,30,40,
51,45,33,48,44,49,39,56,34,53,46,42,50,36,29,32
};

int shift[16] =
{1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1};

uint64_t permute(uint64_t x, int *table, int n, int bits)
{
    uint64_t y = 0;
    for(int i=0;i<n;i++)
        y = (y << 1) | ((x >> (bits-table[i])) & 1);
    return y;
}

uint32_t leftShift(uint32_t x, int n)
{
    return ((x << n) | (x >> (28-n))) & 0x0FFFFFFF;
}

int main()
{
    uint64_t key = 0x133457799BBCDFF1ULL;
    uint64_t k56, k48;
    uint32_t C, D;

    /* PC-1: 64-bit key -> 56-bit key */
    k56 = permute(key, PC1, 56, 64);

    C = (k56 >> 28) & 0x0FFFFFFF;
    D = k56 & 0x0FFFFFFF;

    for(int i=0;i<16;i++)
    {
        C = leftShift(C, shift[i]);
        D = leftShift(D, shift[i]);

        k48 = permute(((uint64_t)C << 28) | D,
                      PC2, 48, 56);

        printf("K%2d = %012llX\n",
               i+1, (unsigned long long)k48);
    }

    return 0;
}
