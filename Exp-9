#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create the 5 x 5 Playfair matrix */
void createMatrix(char key[]) {
    int used[26] = {0};
    int i, j, k = 0;
    char ch;

    used['J' - 'A'] = 1;   // Combine I and J

    /* Put key letters into matrix */
    for (i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    /* Put remaining alphabet letters */
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (!used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }
}

/* Find position of a character */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Decrypt Playfair ciphertext */
void decrypt(char ciphertext[]) {
    int i;
    int r1, c1, r2, c2;
    char a, b;

    for (i = 0; ciphertext[i] != '\0'; i += 2) {

        a = ciphertext[i];
        b = ciphertext[i + 1];

        findPosition(a, &r1, &c1);
        findPosition(b, &r2, &c2);

        if (r1 == r2) {
            /* Same row: move left */
            c1 = (c1 + 4) % 5;
            c2 = (c2 + 4) % 5;
        }
        else if (c1 == c2) {
            /* Same column: move up */
            r1 = (r1 + 4) % 5;
            r2 = (r2 + 4) % 5;
        }
        else {
            /* Rectangle rule */
            int temp = c1;
            c1 = c2;
            c2 = temp;
        }

        printf("%c%c", matrix[r1][c1], matrix[r2][c2]);
    }
}

int main() {
    char key[] = "MONARCHY";

    char ciphertext[] =
        "KXJEYUREBEZWEHEWRYTUHEYFS"
        "KREHEGOYFIWTTTUOLKSYCAJPO"
        "BOTEIZONTXBYBNTGONE YCUZWR"
        "GDSONSXBOUYWRHEBAAHYUSEDQ";

    /* Remove accidental space from ciphertext */
    char clean[200];
    int i, j = 0;

    for (i = 0; ciphertext[i] != '\0'; i++) {
        if (isalpha(ciphertext[i]))
            clean[j++] = toupper(ciphertext[i]);
    }
    clean[j] = '\0';

    createMatrix(key);

    printf("Playfair Matrix:\n");
    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    printf("\nDecrypted text:\n");
    decrypt(clean);

    printf("\n");

    return 0;
}
